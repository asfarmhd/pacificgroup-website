# ---------------------------------------------------------------------------
# MAINTENANCE MODE - Pacific Group of Companies
#
# Written to /.htaccess by .github/workflows/deploy.yml when the workflow's
# "maintenance" input is ticked. Do not edit this on the server; the next
# deploy overwrites it.
#
# Everyone except the allowlisted IP gets a bare HTTP 503 from the server
# itself. There is deliberately NO ErrorDocument and no maintenance page:
# a branded "we'll be back" screen still signals a live, tended site, and
# the site is meant to read as simply down.
#
# 503 rather than 404 or 200 is still the right status. It tells search
# engines the outage is temporary so the real pages keep their ranking;
# 404 would invite de-indexing and 200 would let a placeholder be indexed
# as the homepage.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On

  # The office IP passes straight through to the live site.
  RewriteCond %{REMOTE_ADDR} !=202.47.45.251

  RewriteRule ^ - [R=503,L]
</IfModule>

<IfModule mod_headers.c>
  # Tell crawlers roughly when to come back, and keep the outage out of any
  # intermediate cache so turning maintenance off takes effect at once.
  Header always set Retry-After "7200"
  Header always set Cache-Control "no-store, must-revalidate"
</IfModule>
